# Supabase (auto-provided in hosted Edge Functions; only needed for local `supabase functions serve`)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (from @BotFather)
TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=

# Optional LLM providers (if both are set, MiniMax wins)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
